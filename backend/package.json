{
  "name": "bet-to-beat-backend",
  "version": "1.0.0",
  "description": "Bet To Beat - football prediction platform (API)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:locked": "node scripts/locked-leak-test.mjs",
    "test:proxy": "node --no-warnings --test scripts/proxy-guard.test.ts",
    "test:fix201": "node --no-warnings --test scripts/bb-standings.test.ts",
    "test:fix203": "tsc && node --no-warnings --test --test-force-exit scripts/trial-record.test.mjs",
    "test:fix200": "tsc && node --no-warnings --test --test-force-exit scripts/void-rules.test.ts scripts/data-health-store.test.ts scripts/unsettled.test.mjs scripts/tennis-worker.test.mjs",
    "test:fix205": "tsc && node --no-warnings --test --test-force-exit scripts/calendar.test.mjs",
    "test:fix204": "tsc && node --no-warnings --test --test-force-exit scripts/more-predictions.test.mjs",
    "test:fix206": "tsc && node --no-warnings --test --test-force-exit scripts/how-it-works.test.mjs",
    "lint": "eslint src/**/*.ts",
    "migrate": "ts-node src/database/migrations.ts",
    "test:fix202": "tsc && node --no-warnings --test --test-force-exit scripts/worker-split.test.mjs",
    "test:fix208": "tsc && node --no-warnings --test --test-force-exit scripts/live-box.test.mjs",
    "test:fix209": "tsc && node --no-warnings --test --test-force-exit scripts/scorers.test.mjs",
    "test:fix210": "tsc && node --no-warnings --test --test-force-exit scripts/no-web-compute.test.mjs",
    "test:fix211": "tsc && node --no-warnings --test --test-force-exit scripts/player-photos.test.mjs",
    "test:fix212": "tsc && node --no-warnings --test --test-force-exit scripts/fd-freeze.test.mjs",
    "test:fix212b": "tsc && node --no-warnings --test --test-force-exit scripts/fd-twins-startup.test.mjs",
    "test:fix215": "tsc && node --no-warnings --test --test-force-exit scripts/season-sim.test.mjs scripts/season-forecast.test.mjs",
    "test:fix214": "tsc && node --no-warnings --test --test-force-exit scripts/photo-matcher.test.mjs scripts/web-log.test.mjs",
    "test:fix216": "tsc && node --no-warnings --test --test-force-exit scripts/pick-emails.test.mjs",
    "test:fix217": "tsc && node --no-warnings --test --test-force-exit scripts/nba-v4.test.mjs",
    "test:fix219": "tsc && node --no-warnings --test --test-force-exit scripts/bb-grid.test.mjs",
    "test:fix220": "tsc && node --no-warnings --test --test-force-exit scripts/af-calib.test.mjs",
    "test:fix222": "tsc && node --no-warnings --test --test-force-exit scripts/fix222.test.mjs",
    "test:fix221": "tsc && node --no-warnings --test --test-force-exit scripts/big-lists.test.mjs scripts/photo-matcher.test.mjs"
  },
  "keywords": [
    "football",
    "analytics",
    "prediction",
    "sports"
  ],
  "author": "Yarin Boker",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.5",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^8.5.1",
    "pg": "^8.11.3",
    "redis": "^4.6.11",
    "sharp": "0.33.5",
    "socket.io": "^4.7.2",
    "typeorm": "^0.3.17",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
